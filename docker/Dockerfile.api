FROM golang:1.26.1-alpine3.22 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/threat-service .

FROM alpine:3.22.1

RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/threat-service /app/threat-service
COPY config/config.yaml /app/config/config.yaml
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/threat-service", "--config", "/app/config/config.yaml"]
